// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ProductUnit {
  BAG
  PIECE
  KG
  TON
  BOX
  BUNDLE
  LITER
  FEET
  METER
  SHEET
  CM
  INCH
  ROLL
}

enum TransactionType {
  PURCHASE
  BILL
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum BillType {
  GST
  NON_GST
}

enum GstCalculationMode {
  EXCLUSIVE
  INCLUSIVE
}

enum PaymentMode {
  CASH
  ONLINE
  CHEQUE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  CANCELLED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  Role                   @default(ADMIN)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryTransactions InventoryTransaction[]
  bills                 Bill[]
  categoriesCreated     Category[]             @relation("CategoryCreatedBy")
  categoriesUpdated     Category[]             @relation("CategoryUpdatedBy")
  productsCreated       Product[]              @relation("ProductCreatedBy")
  productsUpdated       Product[]              @relation("ProductUpdatedBy")
}

model Category {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  description    String
  imageUrl       String
  visibility     Boolean   @default(true)
  displayOrder   Int       @default(0)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdById    String
  createdBy      User      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedById    String
  updatedBy      User      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  products       Product[]

  @@index([slug])
  @@index([displayOrder])
  @@index([deletedAt])
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  slug           String          @unique
  name           String
  brand          String?
  description    String
  unit           ProductUnit
  status         ProductStatus   @default(DRAFT)
  featured       Boolean         @default(false)
  specifications Json
  applications   String[]
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdById    String
  createdBy      User            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedById    String
  updatedBy      User            @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  images         ProductImage[]
  inventory      Inventory?
  pricing        ProductPricing?
  billItems      BillItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([deletedAt])
}

model ProductImage {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  publicId     String
  displayOrder Int       @default(0)
  altText      String?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([productId])
  @@index([deletedAt])
}

model ProductPricing {
  id                 String   @id @default(uuid())
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchasePrice      Decimal  @db.Decimal(10, 2)
  sellingPrice       Decimal  @db.Decimal(10, 2)
  defaultBillingRate Decimal  @db.Decimal(10, 2)
  gstRate            Decimal  @default(18.00) @db.Decimal(5, 2)
  hsnCode            String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Inventory {
  id            String                 @id @default(uuid())
  productId     String                 @unique
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock  Int                    @default(0)
  reorderLevel  Int                    @default(5)
  lastUpdatedBy String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  transactions  InventoryTransaction[]

  @@index([productId])
}

model InventoryTransaction {
  id                String          @id @default(uuid())
  inventoryId       String?
  inventory         Inventory?      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type              TransactionType
  quantity          Int
  referenceDocument String?
  notes             String?
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  createdAt         DateTime        @default(now())

  // Purchase tracking fields
  supplierName      String?
  unitPrice         Decimal?        @db.Decimal(10, 2)
  totalPrice        Decimal?        @db.Decimal(10, 2)
  transactionDate   DateTime        @default(now())
  
  // Ad-hoc manual purchase fields
  manualProductName String?
  manualProductUnit String?

  @@index([inventoryId])
}

model Bill {
  id                 String             @id @default(uuid())
  invoiceNumber      String             @unique
  customerName       String
  customerPhone      String
  customerGst        String?
  billingAddress     String
  deliveryAddress    String
  placeOfSupply      String             @default("State")
  billType           BillType
  paymentMode        PaymentMode
  paymentStatus      PaymentStatus      @default(PENDING)
  invoiceStatus      InvoiceStatus      @default(GENERATED)
  gstCalculationMode GstCalculationMode @default(EXCLUSIVE)
  subtotal           Decimal            @db.Decimal(10, 2)
  discount           Decimal            @default(0.00) @db.Decimal(10, 2)
  gstAmount          Decimal            @default(0.00) @db.Decimal(10, 2)
  roundOff           Decimal            @default(0.00) @db.Decimal(10, 2)
  grandTotal         Decimal            @db.Decimal(10, 2)
  notes              String?
  transportDetails   String?
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  createdAt           DateTime           @default(now())
  deletedAt          DateTime?
  items              BillItem[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([deletedAt])
}

model BillItem {
  id                 String   @id @default(uuid())
  billId             String
  bill               Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName        String
  sku                String   @default("")
  hsnCode            String   @default("")
  unit               String
  quantity           Int
  unitPrice          Decimal  @db.Decimal(10, 2)
  defaultBillingRate Decimal  @db.Decimal(10, 2)
  discount           Decimal  @default(0.00) @db.Decimal(10, 2)
  gstRate            Decimal  @default(0.00) @db.Decimal(5, 2)
  gstAmount          Decimal  @default(0.00) @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)
  finalLineTotal     Decimal  @default(0.00) @db.Decimal(10, 2)

  @@index([billId])
  @@index([productId])
}

model InvoiceCounter {
  year          Int      @id
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  updatedAt   DateTime    @updatedAt

  @@index([key])
}
