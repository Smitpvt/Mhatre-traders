# Port to run the server on
PORT=5000

# Environment mode (development, production, test)
NODE_ENV=development

# Database Connection URL (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://username:password@localhost:6543/mhatre_traders?pgbouncer=true
DIRECT_URL=postgresql://username:password@localhost:5432/mhatre_traders

# JWT Secret (Must be a cryptographically secure random string, at least 32 characters long)
JWT_SECRET=your_jwt_secret_key_here_must_be_long_and_secure
JWT_EXPIRES_IN=1d

# CORS Allowed Origins (Comma-separated URLs of frontend clients)
CLIENT_URLS=http://localhost:5173,https://mhatretraders.com,https://www.mhatretraders.com

# Cloudinary Credentials (For storing product images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Administrator Seed Credentials
ADMIN_EMAIL=admin@mhatretraders.com
ADMIN_PASSWORD=admin12345
